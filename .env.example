# ==========================================
# SNY PERFUMES - PRODUCTION ENVIRONMENT CONFIG
# ==========================================

# 1. Supabase (Database & Order Management)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Razorpay (Payments & Webhooks)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 3. Shiprocket (Automated Courier Logistics)
SHIPROCKET_EMAIL=your-shiprocket-account-email@example.com
SHIPROCKET_PASSWORD=your-shiprocket-password
SHIPROCKET_PICKUP_LOCATION=Primary_Warehouse

# 4. App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
